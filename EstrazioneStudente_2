//classe

import java.util.Scanner;

public class Violenzometro {
    public static Scanner scanner = new Scanner(System.in);
    private int lvViolenza;
    private int stageViolenza;
    private String risposta;
    private String[] domande;

    public Violenzometro() {
        this.lvViolenza = 0;
        this.stageViolenza = 0;
        this.risposta = "Il tuo partner non ti maltratta.";
        this.domande = new String[]{"-"};
    }

    public Violenzometro(int lvViolenza, int stageViolenza, String risposta, String[] domande) {
        this.lvViolenza = lvViolenza;
        this.stageViolenza = stageViolenza;
        this.risposta = risposta;
        this.domande = new String[]{"Il tuo partner ti ignora?", "Il tuo partner ti inganna?", "Il tuo partner ti sminuisce?", "Il tuo partner ti umilia?", "Il tuo partner ti controlla?", "Il tuo partner ti ricatta?", "Il tuo partner ti isola?", "Il tuo partner ti provoca sensi di colpa?", "Il tuo partner ti perseguita?", "Il tuo partner ti maltratta?", "Con lui non ti senti al sicuro?", "Il tuo partner ti colpisce/ferisce?", "Il tuo partner ti minaccia di morte?", "Il tuo partner ti minaccia con armi?", "Il tuo partner ti costringe ad avere rapporti sessuali?", "Pensi che potrebbe essere capace\n" + "di ucciderti o farsi del male?"};

    }

    public int getLvViolenza() {
        return lvViolenza;
    }

    public int getStageViolenza() {
        return stageViolenza;
    }

    public String getRisposta() {
        return risposta;
    }

    public String[] getDomande() {
        return domande;
    }

    public void setLvViolenza(int lvViolenza) {
        this.lvViolenza = lvViolenza;
    }

    public void setStageViolenza(int stageViolenza) {
        this.stageViolenza = stageViolenza;
    }

    public void setRisposta(String risposta) {
        this.risposta = risposta;
    }

    public void setDomande(String[] domande) {
        this.domande = domande;
    }

    public void violenzaDetector() {
        for (int i = 0; i < 16; i++) {
            System.out.println("Domanda " + i + ": " + domande[i] + "\nScelta(Si/No): ");
            risposta = scanner.nextLine().trim();
            if (risposta.equals("si")) lvViolenza = i;
        }
        if (lvViolenza == 0)
            System.out.println("Risultato delle sue domande: Il tuo partner non è violento nei tuoi confronti.");
        else if (lvViolenza <= 5 && lvViolenza >= 1)
            System.out.println("Risultato delle sue domande: Chiama i tuoi familiari.");
        else if (lvViolenza > 5 && lvViolenza <= 10)
            System.out.println("Risultato delle sue domande: Vai ad un centro anti-violenza.");
        else System.out.println("Risultato delle sue domande: Chiama immediatamente la polizia.");
    }

    public void visualizza() {
        System.out.println("----- VIOLENZAMETRO -----\n");
        violenzaDetector();
    }
}


//main

import java.util.Scanner;

public static void main(String[] args) {
    Scanner scanner = new Scanner(System.in);
    int lvViolenza = 0, stageViolenza = 0;
    String risposta = "Il tuo partner non ti maltratta.";
    String[] domande = new String[]{"-"};
    Violenzometro v1 = new Violenzometro(lvViolenza,stageViolenza,risposta,domande);

    v1.visualizza();

}

